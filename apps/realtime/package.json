{
  "name": "@redbridge/faceling-realtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OpenAI Realtime API 음성 대화에 실시간 표정을 붙이는 예제",
  "scripts": {
    "dev": "tsx --conditions=faceling-source server.ts",
    "record": "tsx --conditions=faceling-source scripts/record.ts",
    "compare": "tsx --conditions=faceling-source scripts/compare-judges.ts",
    "build:pages": "vite build --mode pages",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@redbridge/faceling-core": "*",
    "@redbridge/faceling-openai-realtime": "*",
    "@redbridge/faceling-rigs": "*",
    "@redbridge/faceling-server": "*",
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
