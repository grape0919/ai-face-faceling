{
  "name": "@redbridge/faceling-core",
  "version": "0.2.0",
  "description": "Expression engine for voice AI: reads the conversation text, picks an action per face part and outputs ARKit 52 values in real time",
  "keywords": [
    "faceling",
    "avatar",
    "facial-expression",
    "arkit",
    "blendshapes",
    "voice-ai",
    "realtime"
  ],
  "license": "MIT",
  "author": "RED BRIDGE DEV",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grape0919/ai-face-faceling.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/grape0919/ai-face-faceling/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/grape0919/ai-face-faceling/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "faceling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "faceling-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
