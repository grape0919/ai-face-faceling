{
  "name": "faceling",
  "private": true,
  "version": "0.0.0",
  "description": "내 AI의 얼굴. 음성 AI 의 말을 읽고 실시간으로 표정을 만드는 엔진",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @redbridge/faceling-core && npm run build -w @redbridge/faceling-rigs -w @redbridge/faceling-openai-realtime -w @redbridge/faceling-server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "rt:dev": "npm run dev -w @redbridge/faceling-realtime",
    "rt:record": "npm run record -w @redbridge/faceling-realtime",
    "rt:pages": "npm run build:pages -w @redbridge/faceling-realtime",
    "lab:dev": "npm run dev -w @redbridge/faceling-offline-lab",
    "lab:session": "npm run session -w @redbridge/faceling-offline-lab --",
    "pack:check": "npm pack --dry-run -w @redbridge/faceling-core -w @redbridge/faceling-rigs -w @redbridge/faceling-openai-realtime -w @redbridge/faceling-server"
  },
  "license": "MIT"
}
