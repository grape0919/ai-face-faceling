{
  "name": "faceling",
  "private": true,
  "version": "0.0.0",
  "description": "내 AI의 얼굴. 음성 AI 의 말을 읽고 실시간으로 표정을 만드는 엔진",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @faceling/core && npm run build -w @faceling/rigs -w @faceling/openai-realtime -w @faceling/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "rt:dev": "npm run dev -w @faceling/realtime",
    "lab:dev": "npm run dev -w @faceling/offline-lab",
    "lab:session": "npm run session -w @faceling/offline-lab --",
    "pack:check": "npm pack --dry-run -w @faceling/core -w @faceling/rigs -w @faceling/openai-realtime -w @faceling/server"
  },
  "license": "MIT"
}
