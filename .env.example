# 이 파일을 .env 로 복사한 뒤 필요한 키만 채운다. 키 없이도 mock 분석기와 naive 정렬로 전체 경로가 동작한다.

# Jev 분석기 (--analyzer jev)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# 소형 LLM 대조군 (--analyzer llm)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# 단어 타임스탬프 정렬 (--aligner whisper)
OPENAI_API_KEY=

# 실시간 음성 대화 (npm run rt:dev). OPENAI_API_KEY 를 함께 쓴다.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# 말하는 도중의 전사에 쓰는 모델
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
